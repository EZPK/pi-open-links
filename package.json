    "links",
    "neovim",
    "editor",
    "omarchy"
  ],
  "author": "EZPK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EZPK/pi-open-links.git"
  },
  "homepage": "https://github.com/EZPK/pi-open-links",
  "bugs": {
    "url": "https://github.com/EZPK/pi-open-links/issues"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/markdown.test.ts",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22.6"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
